<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>

<ScrollPane fitToHeight="true" prefWidth="300.0" vbarPolicy="NEVER" xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tentackle.preferenzr.gui.locale.LocaleSelector">
   <content>
      <HBox fx:id="localePane" alignment="BASELINE_LEFT" spacing="15.0">
         <children>
            <Button fx:id="addLocaleButton" mnemonicParsing="false" text="%addLocale">
               <HBox.margin>
                  <Insets left="5.0" top="5.0" />
               </HBox.margin>
            </Button>
            <CheckBox mnemonicParsing="false" text="CheckBox" />
         </children>
      </HBox>
   </content>
</ScrollPane>
