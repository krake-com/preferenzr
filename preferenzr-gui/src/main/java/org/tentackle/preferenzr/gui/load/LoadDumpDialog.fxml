<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>

<BorderPane xmlns="http://javafx.com/javafx/16" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.tentackle.preferenzr.gui.load.LoadDumpDialog">
   <center>
      <GridPane hgap="5.0" vgap="5.0" BorderPane.alignment="CENTER">
        <columnConstraints>
          <ColumnConstraints hgrow="SOMETIMES" />
          <ColumnConstraints hgrow="ALWAYS" />
        </columnConstraints>
        <rowConstraints>
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
          <RowConstraints minHeight="10.0" prefHeight="30.0" vgrow="SOMETIMES" />
        </rowConstraints>
         <children>
            <Label text="%file" GridPane.halignment="RIGHT" />
            <Label fx:id="fileLabel" GridPane.columnIndex="1" />
            <Label text="%node" GridPane.halignment="RIGHT" GridPane.rowIndex="1" />
            <Label fx:id="pathLabel" GridPane.columnIndex="1" GridPane.rowIndex="1" />
            <Label text="%target" GridPane.halignment="RIGHT" GridPane.rowIndex="2" />
            <RadioButton fx:id="systemButton" mnemonicParsing="false" text="%system preferences" GridPane.columnIndex="1" GridPane.rowIndex="2" />
            <RadioButton fx:id="userButton" mnemonicParsing="false" text="%user" GridPane.halignment="RIGHT" GridPane.rowIndex="3" />
            <ComboBox fx:id="userBox" prefWidth="240.0" GridPane.columnIndex="1" GridPane.rowIndex="3" />
            <Label text="%mode" GridPane.halignment="RIGHT" GridPane.rowIndex="4" />
            <RadioButton fx:id="mergeButton" mnemonicParsing="false" text="%merge" GridPane.columnIndex="1" GridPane.rowIndex="4" />
            <RadioButton fx:id="replaceButton" mnemonicParsing="false" text="%replace" GridPane.columnIndex="1" GridPane.rowIndex="5" />
         </children>
         <BorderPane.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </BorderPane.margin>
      </GridPane>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="5.0">
         <children>
            <Button fx:id="cancelButton" mnemonicParsing="false" text="%cancel" />
            <Button fx:id="loadButton" mnemonicParsing="false" text="%load" />
         </children>
         <BorderPane.margin>
            <Insets bottom="5.0" left="5.0" right="5.0" top="5.0" />
         </BorderPane.margin>
      </HBox>
   </bottom>
</BorderPane>
